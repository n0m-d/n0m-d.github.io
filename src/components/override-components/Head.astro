---
import theme from "@/config/theme.json";
const { head } = Astro.locals.starlightRoute;

// font families
const pf = theme.fonts.font_family.primary;
// @ts-ignore
const sf = theme.fonts.font_family.secondary ;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}
// @ts-ignore
if (theme.fonts.font_family.secondary) {
// @ts-ignore
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}

---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<!-- Detect software rendering / no GPU before first paint -->
<script is:inline>
  (function () {
    function isLowPower() {
      var n = navigator,
        c = n.hardwareConcurrency || 1,
        m = n.deviceMemory || 4;
      if (c <= 1) return true;
      if (c <= 2 && m <= 2) return true;
      try {
        var x = document.createElement("canvas"),
          g = x.getContext("webgl") || x.getContext("experimental-webgl");
        if (!g) return true;
        var d = g.getExtension("WEBGL_debug_renderer_info");
        if (d) {
          var r = g.getParameter(d.UNMASKED_RENDERER_WEBGL);
          if (
            /swiftshader|llvmpipe|software|mesa|basic render|virgl|softpipe|angle/i.test(
              r
            )
          )
            return true;
        }
        if (g.getParameter(g.MAX_TEXTURE_SIZE) < 4096) return true;
      } catch (e) {
        return true;
      }
      return false;
    }
    if (isLowPower()) document.documentElement.classList.add("low-power");
  })();
</script>

<!-- google font css: loaded at runtime via <link> so the build never has to
     download/parse font files (astro-font chokes on Google's sliced font URLs). -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{pf && (
  <link
    rel="stylesheet"
    href={`https://fonts.googleapis.com/css2?family=${pf}&display=swap`}
  />
)}
{sf && (
  <link
    rel="stylesheet"
    href={`https://fonts.googleapis.com/css2?family=${sf}&display=swap`}
  />
)}
<style is:inline set:html={`:root{
  ${fontPrimary ? `--font-primary:"${fontPrimary}", ${theme.fonts.font_family.primary_type || "sans-serif"};` : ""}
  ${fontSecondary ? `--font-secondary:"${fontSecondary}", ${(theme.fonts.font_family as any).secondary_type || "sans-serif"};` : ""}
}`} />

<script is:inline>
  document.addEventListener(
    "click",
    (event) => {
      const callout = event.target.closest?.(".callout.is-collapsible");
      if (!callout) return;
      callout.classList.toggle("is-collapsed");
    },
    true,
  );
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const callout = event.target.closest?.(".callout.is-collapsible");
    if (!callout || event.target !== callout) return;
    event.preventDefault();
    callout.classList.toggle("is-collapsed");
  });
</script>

