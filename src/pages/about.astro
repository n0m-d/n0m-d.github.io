---
import "@fontsource/syne/700.css";
import "@fontsource/syne/800.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import FontPreload from "../components/FontPreload.astro";
import { Image } from "astro:assets";
import { sigils } from "../data/sigils";

const sections = [
  { cmd: "notes", href: "/getting-started/introduction/overview/" },
  { cmd: "appsec", href: "/appsec/" },
  { cmd: "malware", href: "/malware/" },
  { cmd: "tools", href: "/tools/" },
  { cmd: "about", href: "/about/" },
];

const file = [
  { k: "designation", v: "v0iid" },
  { k: "division", v: "Software Engineer · Application Security" },
  { k: "status", v: "unregistered. still jacked in." },
  { k: "endpoint", v: "github.com/n0m-d", href: "https://github.com/n0m-d" },
];

const vectors = ["appsec", "cve analysis", "web vulns", "code audit"];
const pad = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <FontPreload fonts={["syne-700", "syne-800", "mono-400", "mono-500"]} />
    <title>About — v0iid</title>
    <meta
      name="description"
      content="Operator file. Application security, CVE analysis, web vulnerabilities, code auditing."
    />
    {sections.map((s) => <link rel="prefetch" href={s.href} />)}
  </head>
  <body>
    <div class="crt" aria-hidden="true"></div>

    <header class="bar">
      <a class="brand" href="/">v0iid</a>
      <nav class="rail" aria-label="Primary">
        {sections.map((s, i) => (
          <a class="rail__ch" href={s.href} aria-current={s.cmd === "about" ? "page" : undefined}>
            <span class="rail__n" aria-hidden="true">{pad(i + 1)}</span>
            <span class="rail__l">{s.cmd}</span>
          </a>
        ))}
      </nav>
    </header>

    <main>
      <!-- ── Hero: a television sky over the port ── -->
      <section class="hero">
        <canvas class="sky" id="sky" aria-hidden="true"></canvas>
        <canvas class="port" id="port" aria-hidden="true"></canvas>

        <div class="hero__copy" id="hero-copy">
          <p class="kick"><span class="rec" aria-hidden="true"></span><span id="tune">ch 00 · tuning</span></p>
          <blockquote class="sky-quote">
            <p>The sky above the port was the color of television, tuned to a dead&nbsp;channel.</p>
          </blockquote>
          <p class="tag">
            <span class="name" data-decode="v0iid" aria-label="v0iid">v0iid</span>
            <span class="tag__sep">/</span> operator file
          </p>
        </div>
      </section>

      <!-- ── 01 Personnel ── -->
      <section class="block" id="file">
        <header class="head reveal">
          <p class="ch">ch 01</p>
          <h2>personnel</h2>
          <p class="hint">who's on the other end of the line</p>
          <canvas class="strip" data-seed="1" aria-hidden="true"></canvas>
        </header>
        <dl class="file">
          {file.map((row, i) => (
            <div class="row reveal" style={`--d:${i * 90}ms`}>
              <dt>{row.k}</dt>
              <dd>
                {row.href ? (
                  <a href={row.href} target="_blank" rel="noopener noreferrer">{row.v} ↗</a>
                ) : (
                  row.v
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ── 02 Imprint ── -->
      <section class="block">
        <header class="head reveal">
          <p class="ch">ch 02</p>
          <h2>imprint</h2>
          <p class="hint">what holds the signal</p>
          <canvas class="strip" data-seed="2" aria-hidden="true"></canvas>
        </header>
        <div class="imprint">
          <p class="bio reveal">
            Mostly application security, CVE analysis, web vulnerabilities, code auditing.
            <em>Whatever else manages to hold the attention long enough to matter.</em>
            Notes archived here are reconstructed paths, not performance.
          </p>
          <ul class="vectors reveal" aria-label="Skill vectors">
            {vectors.map((v) => <li>{v}</li>)}
          </ul>
        </div>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
          {[0, 1].map(() => (
            <span class="marquee__set">
              {vectors.map((v) => (
                <>
                  <span class="marquee__word">{v}</span>
                  <span class="marquee__dot">▒</span>
                </>
              ))}
            </span>
          ))}
        </div>
      </div>

      <!-- ── 03 Clearance ── -->
      <section class="block">
        <header class="head reveal">
          <p class="ch">ch 03</p>
          <h2>clearance</h2>
          <p class="hint">{pad(sigils.length)} credentials on file</p>
          <canvas class="strip" data-seed="3" aria-hidden="true"></canvas>
        </header>
        <ol class="certs">
          {sigils.map((s, i) => {
            const inner = (
              <>
                <span class="cert__idx">{pad(i + 1)}</span>
                <span class="cert__code">{s.code}</span>
                <span class="cert__name">{s.name}</span>
                <span class="cert__issuer">{s.issuer}</span>
                <Image src={s.art} alt="" class="cert__thumb" widths={[96, 160]} sizes="64px" />
              </>
            );
            return (
              <li class="cert reveal" data-peek={i} style={`--d:${i * 80}ms`}>
                {s.href ? (
                  <a class="cert__link" href={s.href} target="_blank" rel="noopener noreferrer">{inner}</a>
                ) : (
                  <div class="cert__link">{inner}</div>
                )}
              </li>
            );
          })}
        </ol>
      </section>

      <!-- Cursor-follow badge preview (pointer devices only) -->
      <div class="peek" aria-hidden="true">
        {sigils.map((s, i) => (
          <Image src={s.art} alt="" class="peek__img" data-peek-img={i} widths={[240, 320]} sizes="220px" />
        ))}
      </div>
    </main>

    <footer class="edge">
      <span>© {new Date().getFullYear()} v0iid </span>
      <span>ch 00 · <span id="clock">--:--:--</span></span>
    </footer>

    <script>
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches;

      /* ───────── shared signal state ───────── */
      let px = 0.5, // smoothed pointer x (0..1)
        tpx = 0.5,
        energy = 0,
        tEnergy = 0,
        lastX = -1,
        lastY = -1,
        t = 0,
        frame = 0;
      // dead-channel state: static level + horizontal tearing during signal loss
      let noise = reduce ? 0.16 : 0.7; // starts fully detuned, tunes in
      let tear = 0;
      const BASE_NOISE = 0.16;

      addEventListener(
        "pointermove",
        (e) => {
          if (lastX >= 0) tEnergy = Math.min(1, tEnergy + Math.hypot(e.clientX - lastX, e.clientY - lastY) / 900);
          lastX = e.clientX;
          lastY = e.clientY;
          tpx = e.clientX / innerWidth;
        },
        { passive: true }
      );

      // layered "noise"
      const n = (x: number, y: number, s: number) =>
        Math.sin(x * 0.021 + s * 1.7 + y * 0.6) * 0.5 +
        Math.sin(x * 0.047 - s * 1.1 + y * 1.3) * 0.3 +
        Math.sin(x * 0.11 + s * 2.3 - y * 0.9) * 0.2;

      type Surface = { el: HTMLCanvasElement; ctx: CanvasRenderingContext2D; w: number; h: number; visible: boolean };
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const surface = (el: HTMLCanvasElement, scale = dpr): Surface => {
        const s: Surface = { el, ctx: el.getContext("2d")!, w: 0, h: 0, visible: true };
        const fit = () => {
          s.w = el.clientWidth;
          s.h = el.clientHeight;
          el.width = Math.max(1, Math.round(s.w * scale));
          el.height = Math.max(1, Math.round(s.h * scale));
          s.ctx.setTransform(scale, 0, 0, scale, 0, 0);
        };
        fit();
        new ResizeObserver(() => {
          fit();
          if (reduce) paintAll();
        }).observe(el);
        new IntersectionObserver(([en]) => (s.visible = en.isIntersecting)).observe(el);
        return s;
      };

      /* Draw stacked ridgelines into a surface. */
      const ridges = (
        s: Surface,
        o: { lines: number; top: number; bottom: number; amp: number; seed: number; alpha: number; tear: number }
      ) => {
        const { ctx, w, h } = s;
        const gap = (o.bottom - o.top) / Math.max(1, o.lines - 1);
        const step = Math.max(3, w / 240);
        const focus = px * w;
        for (let i = 0; i < o.lines; i++) {
          const y0 = o.top + i * gap;
          const depth = o.lines > 1 ? i / (o.lines - 1) : 0.5;
          // signal loss: some lines slip sideways, like a rolling picture
          const shift = o.tear > 0 && Math.random() < 0.45 ? (Math.random() - 0.5) * 80 * o.tear : 0;
          ctx.beginPath();
          ctx.moveTo(-10, y0);
          for (let x = -10; x <= w + step; x += step) {
            const dx = (x - focus) / (w * 0.22);
            const env =
              Math.exp(-dx * dx) * (0.55 + energy * 0.9) + Math.exp(-((x - w / 2) ** 2) / (w * w * 0.08)) * 0.25;
            const v = Math.abs(n(x + shift + o.seed * 173, i + o.seed * 7, t + depth * 0.4));
            ctx.lineTo(x, y0 - v * gap * o.amp * env);
          }
          ctx.lineTo(w + 10, h + 10);
          ctx.lineTo(-10, h + 10);
          ctx.closePath();
          ctx.fillStyle = "#000";
          ctx.fill();
          const a = (0.12 + Math.sin(depth * Math.PI) * 0.4) * o.alpha;
          ctx.strokeStyle = `rgba(226, 232, 248, ${a})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      };

      /* ───────── surfaces ───────── */
      const skyEl = document.getElementById("sky") as HTMLCanvasElement | null;
      const portEl = document.getElementById("port") as HTMLCanvasElement | null;
      const copy = document.getElementById("hero-copy");
      const tune = document.getElementById("tune");

      // the sky: low-res static, scaled up with hard pixels
      const SKY_SCALE = 1 / 3;
      const sky = skyEl ? surface(skyEl, SKY_SCALE) : null;
      let skyImg: ImageData | null = null;
      let skyBuf: Uint32Array | null = null;
      const paintSky = () => {
        if (!sky) return;
        const W = sky.el.width,
          H = sky.el.height;
        if (!skyImg || skyImg.width !== W || skyImg.height !== H) {
          skyImg = sky.ctx.createImageData(W, H);
          skyBuf = new Uint32Array(skyImg.data.buffer);
        }
        const buf = skyBuf!;
        for (let i = 0; i < buf.length; i++) {
          const v = (Math.random() * 255) | 0;
          // ABGR (little-endian): a cool, television grey-blue
          buf[i] = (255 << 24) | (v << 16) | (((v * 0.95) | 0) << 8) | ((v * 0.88) | 0);
        }
        sky.ctx.putImageData(skyImg, 0, 0);
        sky.el.style.opacity = String(noise);
      };

      const port = portEl ? surface(portEl) : null;
      const paintPort = () => {
        if (!port || !copy) return;
        // the skyline starts just under the text, never above 40% of the hero
        const copyBottom = copy.offsetTop + copy.offsetHeight;
        const top = Math.max(port.h * 0.4, copyBottom + 40);
        port.ctx.clearRect(0, 0, port.w, port.h);
        ridges(port, {
          lines: Math.max(12, Math.min(28, Math.round((port.h - top) / 16))),
          top,
          bottom: port.h - 8,
          amp: 3.4,
          seed: 0,
          alpha: 1,
          tear,
        });
      };

      // small live strips under each section heading
      const strips = [...document.querySelectorAll<HTMLCanvasElement>(".strip")].map((el) => ({
        s: surface(el),
        seed: Number(el.dataset.seed) || 1,
      }));
      const paintStrips = () => {
        for (const { s, seed } of strips) {
          if (!s.visible && !reduce) continue;
          s.ctx.clearRect(0, 0, s.w, s.h);
          ridges(s, { lines: 6, top: s.h * 0.45, bottom: s.h - 2, amp: 2.6, seed, alpha: 0.9, tear: tear * 0.6 });
        }
      };

      function paintAll() {
        paintSky();
        paintPort();
        paintStrips();
      }

      /* ───────── dead channel: tune in, then lose signal now and then ───────── */
      let nextLoss = performance.now() + 7000;
      let lossUntil = 0;
      const setTune = (s: string) => {
        if (tune && tune.textContent !== s) tune.textContent = s;
      };

      const loop = (now: number) => {
        frame++;
        px += (tpx - px) * 0.05;
        energy += (tEnergy - energy) * 0.04;
        tEnergy *= 0.985;
        t += 0.012 + energy * 0.02;

        if (now > nextLoss) {
          lossUntil = now + 180 + Math.random() * 240;
          nextLoss = now + 6000 + Math.random() * 8000;
        }
        const losing = now < lossUntil;
        tear = losing ? 1 : tear * 0.8;
        const target = losing ? 0.62 : BASE_NOISE;
        noise += (target - noise) * (losing ? 0.5 : 0.035);

        if (noise > 0.3 && now < 2200) setTune("ch 00 · tuning");
        else if (losing) setTune("ch 00 · no carrier");
        else setTune("ch 00 · dead channel");

        // static at ~20fps reads as television; ridges every frame
        const heroVisible = !sky || sky.visible;
        if (heroVisible && frame % 3 === 0) paintSky();
        if (heroVisible) paintPort();
        paintStrips();
        requestAnimationFrame(loop);
      };

      if (reduce) {
        setTune("ch 00 · dead channel");
        paintAll();
      } else {
        paintAll();
        requestAnimationFrame(loop);
      }

      /* ───────── decode the tag ───────── */
      const glyphs = "░▒▓█#/\\_<>=+";
      const title = document.querySelector<HTMLElement>("[data-decode]");
      if (title && !reduce) {
        const target = title.dataset.decode!;
        const start = performance.now() + 500;
        const DUR = 1100;
        const tick = (now: number) => {
          const p = Math.max(0, Math.min(1, (now - start) / DUR));
          let out = "";
          for (let i = 0; i < target.length; i++) {
            out += p >= ((i + 1) / target.length) * 0.9 ? target[i] : glyphs[(Math.random() * glyphs.length) | 0];
          }
          title.textContent = out;
          if (p < 1) requestAnimationFrame(tick);
          else title.textContent = target;
        };
        requestAnimationFrame(tick);
        setTimeout(() => (title.textContent = target), 2200);
      }

      /* ───────── scroll reveals ───────── */
      const io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (en.isIntersecting) {
              en.target.classList.add("in");
              io.unobserve(en.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      /* ───────── badge peek following the cursor ───────── */
      const peek = document.querySelector<HTMLElement>(".peek");
      if (peek && finePointer && !reduce) {
        const imgs = [...peek.querySelectorAll<HTMLElement>("[data-peek-img]")];
        let x = 0,
          y = 0,
          tx = 0,
          ty = 0,
          live = false,
          raf = 0;
        const follow = () => {
          const vx = tx - x;
          x += vx * 0.16;
          y += (ty - y) * 0.16;
          const rot = Math.max(-14, Math.min(14, vx * 0.12));
          peek.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) rotate(${rot}deg)`;
          raf = live || Math.abs(vx) > 0.5 ? requestAnimationFrame(follow) : 0;
        };
        document.querySelectorAll<HTMLElement>("[data-peek]").forEach((row) => {
          row.addEventListener("pointerenter", (e) => {
            const id = row.dataset.peek;
            imgs.forEach((img) => img.classList.toggle("on", img.dataset.peekImg === id));
            if (!live) {
              x = tx = e.clientX + 140;
              y = ty = e.clientY;
            }
            live = true;
            peek.classList.add("show");
            if (!raf) raf = requestAnimationFrame(follow);
          });
          row.addEventListener("pointermove", (e) => {
            tx = e.clientX + 140;
            ty = e.clientY;
          });
          row.addEventListener("pointerleave", () => {
            live = false;
            peek.classList.remove("show");
          });
        });
      }

      /* ───────── clock ───────── */
      const clock = document.getElementById("clock");
      const tickClock = () => {
        if (clock) clock.textContent = new Date().toLocaleTimeString("en-GB", { hour12: false });
      };
      tickClock();
      setInterval(tickClock, 1000);
    </script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :root {
        --bg: #000000;
        --ink: #eef1f8;
        --mute: #6b7082;
        --faint: #30333f;
        --tv: #9aa3b5; /* the colour of television */
        --accent-rgb: 226, 232, 248;
        --display: "Syne", system-ui, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
        --pad: clamp(1rem, 5vw, 4rem);
      }

      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--mono);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      ::selection {
        background: var(--ink);
        color: var(--bg);
      }

      /* faint CRT scanlines over everything */
      .crt {
        position: fixed;
        inset: 0;
        z-index: 40;
        pointer-events: none;
        background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.022) 0 1px, transparent 1px 3px);
      }

      main,
      .edge {
        position: relative;
        z-index: 5;
      }

      /* ── Bar: brand plate + on-screen channel display ── */
      .bar {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem var(--pad);
        pointer-events: none;
      }
      .bar > * {
        pointer-events: auto;
      }
      .brand {
        font-family: var(--display);
        font-weight: 800;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
        text-shadow: 0 0 18px #000, 0 0 6px #000;
      }

      /* ── Side rail: channels set sideways down the right edge ── */
      .rail {
        position: fixed;
        top: 50%;
        right: clamp(0.6rem, 1.6vw, 1.6rem);
        transform: translateY(-50%);
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.1rem;
        padding: 0 0.6rem;
        background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.75) 25%, rgba(0, 0, 0, 0.75) 75%, transparent);
      }
      /* hairline that runs off above and below the rail */
      .rail::before,
      .rail::after {
        content: "";
        width: 1px;
        height: 4.5rem;
      }
      .rail::before {
        background: linear-gradient(transparent, var(--faint));
      }
      .rail::after {
        background: linear-gradient(var(--faint), transparent);
      }
      .rail__ch {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        writing-mode: vertical-rl;
        padding: 0.2rem 0.35rem;
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        color: #8a8fa0;
        text-shadow: 0 0 6px #000, 0 0 14px #000;
        transition: color 0.25s ease, letter-spacing 0.35s cubic-bezier(0.7, 0, 0.2, 1);
      }
      .rail__n {
        font-size: 0.58rem;
        letter-spacing: 0.1em;
        color: var(--faint);
        transition: color 0.25s ease;
      }
      .rail__ch:hover {
        color: var(--ink);
        letter-spacing: 0.32em;
      }
      .rail__ch:hover .rail__n {
        color: var(--tv);
      }
      .rail__ch[aria-current="page"] {
        color: var(--ink);
      }
      .rail__ch[aria-current="page"] .rail__n {
        color: var(--tv);
      }
      /* tuned-in marker beside the current channel */
      .rail__ch[aria-current="page"]::before {
        content: "";
        position: absolute;
        right: -0.55rem;
        top: 50%;
        width: 4px;
        height: 4px;
        margin-top: -2px;
        border-radius: 50%;
        background: var(--tv);
        box-shadow: 0 0 8px var(--tv);
      }

      /* keep content clear of the rail */
      @media (max-width: 82rem) {
        .hero__copy,
        .block {
          padding-right: max(var(--pad), 4.5rem);
        }
      }

      /* ── Hero ── */
      .hero {
        position: relative;
        min-height: 92svh;
        overflow: hidden;
        background: radial-gradient(90% 60% at 50% 0%, #161a22 0%, #07080b 55%, #000 100%);
      }
      .sky,
      .port {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .sky {
        image-rendering: pixelated;
        opacity: 0.16;
        mix-blend-mode: screen;
        /* static thins out toward the horizon */
        -webkit-mask: linear-gradient(#000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 85%);
        mask: linear-gradient(#000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 85%);
      }
      .hero__copy {
        position: relative;
        z-index: 2;
        width: min(72rem, 100%);
        margin: 0 auto;
        padding: clamp(7rem, 18vh, 10rem) var(--pad) 0;
      }
      .kick {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0 0 1.8rem;
        font-size: 0.72rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--mute);
      }
      .rec {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--tv);
        box-shadow: 0 0 10px var(--tv);
        animation: blink 1.6s steps(2, jump-none) infinite;
      }
      @keyframes blink {
        50% { opacity: 0.15; }
      }
      .sky-quote {
        margin: 0;
      }
      .sky-quote p {
        margin: 0;
        max-width: 17ch;
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.7rem, 4.4vw, 3.6rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
        color: var(--ink);
        text-shadow: 0 0 40px rgba(0, 0, 0, 0.9);
      }
      .cite {
        margin: 1.2rem 0 0;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mute);
      }
      .tag {
        display: inline-flex;
        align-items: baseline;
        gap: 0.6rem;
        margin: 2.4rem 0 0;
        padding: 0.45rem 0.8rem;
        border: 1px solid var(--faint);
        background: rgba(0, 0, 0, 0.6);
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        color: var(--mute);
      }
      .name {
        color: var(--ink);
        font-weight: 500;
        min-width: 5ch;
      }
      .tag__sep {
        color: var(--faint);
      }

      /* ── Blocks: channel label on the left, content on the right ── */
      .block {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: 2rem 4rem;
        width: min(72rem, 100%);
        margin: 0 auto;
        padding: clamp(4rem, 11vh, 7rem) var(--pad);
        border-top: 1px solid #111318;
      }
      .block:last-of-type {
        padding-bottom: clamp(6rem, 16vh, 10rem);
      }
      .head {
        position: sticky;
        top: 6rem;
        align-self: start;
      }
      .ch {
        margin: 0;
        font-size: 0.7rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--tv);
      }
      .head h2 {
        margin: 0.5rem 0 0;
        font-family: var(--display);
        font-weight: 800;
        font-size: 1.7rem;
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .hint {
        margin: 0.7rem 0 0;
        font-size: 0.74rem;
        line-height: 1.5;
        color: var(--mute);
      }
      .strip {
        display: block;
        width: 100%;
        height: 44px;
        margin-top: 1.2rem;
        border-bottom: 1px solid var(--faint);
      }

      /* reveal: wipe up from a hairline */
      .reveal {
        clip-path: inset(0 0 100% 0);
        transform: translateY(18px);
        transition:
          clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1) var(--d, 0ms),
          transform 0.9s cubic-bezier(0.7, 0, 0.2, 1) var(--d, 0ms);
      }
      .reveal.in {
        clip-path: inset(-10% -10% -10% -10%);
        transform: none;
      }

      /* ── Personnel ── */
      .file {
        margin: 0;
      }
      .row {
        position: relative;
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: 1.5rem;
        align-items: baseline;
        padding: 1.2rem 0;
        border-top: 1px solid var(--faint);
      }
      .row:last-child {
        border-bottom: 1px solid var(--faint);
      }
      .row::before {
        content: "";
        position: absolute;
        inset: -1px 0 auto 0;
        height: 1px;
        background: var(--ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.6s cubic-bezier(0.7, 0, 0.2, 1);
      }
      .row:hover::before {
        transform: scaleX(1);
      }
      .row dt {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--mute);
      }
      .row dd {
        margin: 0;
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.1rem, 2.2vw, 1.6rem);
        letter-spacing: -0.02em;
        line-height: 1.2;
      }
      .row dd a {
        background: linear-gradient(var(--ink), var(--ink)) 0 100% / 0 1px no-repeat;
        transition: background-size 0.4s ease;
      }
      .row dd a:hover {
        background-size: 100% 1px;
      }

      /* ── Imprint ── */
      .bio {
        margin: 0;
        max-width: 32ch;
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.35rem, 2.8vw, 2.2rem);
        line-height: 1.2;
        letter-spacing: -0.025em;
      }
      .bio em {
        font-style: normal;
        color: var(--mute);
      }
      .vectors {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 2rem 0 0;
        padding: 0;
        list-style: none;
      }
      .vectors li {
        padding: 0.4rem 0.75rem;
        border: 1px solid var(--faint);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--tv);
      }

      /* ── Marquee ── */
      .marquee {
        position: relative;
        overflow: hidden;
        padding: 1.2rem 0;
        border-block: 1px solid var(--faint);
        transform: rotate(-2deg) scale(1.04);
        background: #000;
        -webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
        mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
      }
      .marquee__track {
        display: flex;
        width: max-content;
        animation: slide 30s linear infinite;
      }
      .marquee:hover .marquee__track {
        animation-duration: 70s;
      }
      .marquee__set {
        display: flex;
        align-items: center;
      }
      .marquee__word {
        font-family: var(--display);
        font-weight: 800;
        font-size: clamp(1.8rem, 5vw, 3.8rem);
        letter-spacing: -0.04em;
        text-transform: uppercase;
        line-height: 1;
        padding: 0 2rem;
        color: transparent;
        -webkit-text-stroke: 1px var(--tv);
      }
      .marquee__word:nth-child(4n + 1) {
        color: var(--ink);
        -webkit-text-stroke: 0;
      }
      .marquee__dot {
        font-size: 1rem;
        color: var(--faint);
      }
      @keyframes slide {
        to { transform: translateX(-50%); }
      }

      /* ── Clearance ── */
      .certs {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .cert {
        border-top: 1px solid var(--faint);
      }
      .cert:last-child {
        border-bottom: 1px solid var(--faint);
      }
      .cert__link {
        position: relative;
        display: grid;
        grid-template-columns: 2rem 9rem minmax(0, 1fr) auto;
        gap: 0.35rem 1.25rem;
        align-items: center;
        padding: 1.3rem 0;
        overflow: hidden;
        isolation: isolate;
        transition: padding 0.45s cubic-bezier(0.7, 0, 0.2, 1), color 0.3s ease;
      }
      .cert__link::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--ink);
        transform: translateY(101%);
        transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1);
        z-index: -1;
      }
      .cert__link:hover {
        color: var(--bg);
        padding-inline: 1rem;
      }
      .cert__link:hover::before {
        transform: none;
      }
      .cert__link:hover .cert__idx,
      .cert__link:hover .cert__issuer {
        color: var(--bg);
      }
      .cert__idx {
        font-size: 0.7rem;
        color: var(--mute);
        letter-spacing: 0.1em;
      }
      .cert__code {
        font-family: var(--display);
        font-weight: 800;
        font-size: clamp(1.2rem, 2vw, 1.6rem);
        letter-spacing: -0.03em;
        line-height: 1.1;
        white-space: nowrap;
      }
      .cert__name {
        font-size: 0.86rem;
      }
      .cert__issuer {
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mute);
        text-align: right;
        white-space: nowrap;
      }
      a.cert__link .cert__issuer::after {
        content: " ↗";
      }
      .cert__thumb {
        display: none;
      }

      .peek {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 30;
        width: 220px;
        aspect-ratio: 1;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.25s ease;
        will-change: transform;
      }
      .peek.show {
        opacity: 1;
      }
      .peek__img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transform: scale(0.85);
        transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.8));
      }
      .peek__img.on {
        opacity: 1;
        transform: none;
      }

      /* ── Edge ── */
      .edge {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.3rem var(--pad);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: var(--faint);
        border-top: 1px solid var(--faint);
        background: var(--bg);
      }

      :focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 4px;
      }

      /* stacked cert rows: narrower screens, or touch (badge shown inline) */
      @media (max-width: 64rem), (hover: none), (pointer: coarse) {
        .cert__link { grid-template-columns: 2rem minmax(0, 1fr) auto; }
        .cert__idx { grid-column: 1; grid-row: 1; }
        .cert__code { grid-column: 2; grid-row: 1; }
        .cert__name { grid-column: 2; grid-row: 2; }
        .cert__issuer { grid-column: 2; grid-row: 3; text-align: left; }
      }
      @media (hover: none), (pointer: coarse) {
        .peek { display: none; }
        .cert__thumb {
          display: block;
          grid-column: 3;
          grid-row: 1 / 4;
          align-self: center;
          width: 48px;
          height: 48px;
          object-fit: contain;
        }
      }

      @media (max-width: 52rem) {
        .block { grid-template-columns: 1fr; gap: 2rem; }
        .head { position: static; }
        .strip { max-width: 22rem; }
      }

      @media (max-width: 40rem) {
        /* too narrow for a side rail: quiet links in the bar, like the index */
        .bar {
          background: linear-gradient(#000 30%, transparent);
          padding-bottom: 1.6rem;
        }
        .rail {
          background: none;
          padding: 0;
          top: 1.15rem;
          right: var(--pad);
          transform: none;
          flex-direction: row;
          gap: 0.75rem;
        }
        .rail::before,
        .rail::after,
        .rail__n,
        .rail__ch[aria-current="page"]::before { display: none; }
        .rail__ch {
          writing-mode: horizontal-tb;
          padding: 0;
          font-size: 0.72rem;
          letter-spacing: 0.04em;
        }
        .rail__ch:hover { letter-spacing: 0.04em; }
        .rail__ch[aria-current="page"] {
          text-decoration: underline;
          text-decoration-color: var(--tv);
          text-underline-offset: 0.45em;
        }
        .hero__copy,
        .block { padding-right: var(--pad); }
        .row { grid-template-columns: 1fr; gap: 0.4rem; }
        .hero { min-height: 88svh; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rec, .marquee__track { animation: none; }
        .reveal { clip-path: none; transform: none; transition: none; }
        .marquee__track { flex-wrap: wrap; width: auto; }
        .marquee__set + .marquee__set { display: none; }
      }
    </style>
  </body>
</html>
