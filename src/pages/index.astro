        nav { transform: translateX(-50%); }
        .sweep-beam, .meta-row strong, .chroma-bleed::before, .chroma-bleed::after,
        .net-mesh, .ice-fall span, .construct-frame span, #scroll-progress,
        .hex-field, .signal-glitch::before, .signal-glitch::after,
        .title-section span, .hud-ticker, .card::after,
        .boot-terminal, .boot-cursor, .boot-track, .boot-ticker span, .boot-burst,
        .boot-screen--exit, .boot-footer__status--linked,
        .boot-ascii__line--chroma,
