        .hero-signal__stream-inner { transform: none; }
        .hero-signal__bars i { transform: scaleY(0.45); opacity: 0.5; }
        .boot-terminal { opacity: 1; transform: none; }
        .boot-log, .boot-ascii__line, .boot-pre__line, .boot-quote, .boot-whisper { transition: none; }
        .boot-whisper--in { color: rgba(185, 200, 185, 0.54); }
        .boot-quote--in { opacity: 1; color: rgba(165, 180, 165, 0.52); }
        body::before, body::after { display: none; }
        .beat-inner, .card { transition: none !important; }
        .backdrop { filter: none; transform: none; }
        .card:hover { transform: none; }
      }

      .scroll-hint {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: var(--type-micro);
        font-weight: 500;
        letter-spacing: var(--track-wide);
        text-transform: uppercase;
        color: var(--text-muted);
        animation: scrollDrift 3s ease-in-out infinite;
        pointer-events: none;
        margin: 0;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        border: 1px solid rgba(var(--phosphor-rgb), 0.1);
        background: rgba(6, 14, 20, 0.4);
        backdrop-filter: blur(8px);
      }
      .scroll-hint em {
        color: var(--phosphor);
        font-style: normal;
        display: inline-block;
        margin-left: 0.35em;
      }
      @keyframes scrollDrift {
        0%, 100% { opacity: 0.35; transform: translateX(-50%); }
        50% { opacity: 0.95; transform: translateX(-50%) translateY(6px); }
      }

      @media (max-width: 768px) {
        .nav-nexus__deck,
        .hero-signal__unit,
        .poster-shell {
          backdrop-filter: blur(10px) saturate(1.1);
        }
        nav {
          top: 0.65rem;
          width: calc(100% - 1.25rem);
        }
        .nav-nexus__orbit { display: none; }
        .nav-nexus__deck {
          clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 12px 100%, 0 50%);
        }
        .nav-nexus__row { padding: 0.55rem 1rem; gap: 0.35rem; }
        .nav-links { display: none; }
        .nav-cta { font-size: 0.62rem; padding: 0.42rem 0.85rem; }
        .beat { padding: 5.5rem 1.25rem 4rem; }
        .beat--hero { padding-top: 5.75rem; }
        #enter.beat,
        #archive.beat { padding: 0; }
      }
    </style>
