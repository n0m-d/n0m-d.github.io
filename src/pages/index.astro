---
import "@fontsource/syne/700.css";
import "@fontsource/syne/800.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import FontPreload from "../components/FontPreload.astro";

// All copy is from the existing site. Sparse, floating in the depth.
const sections = [
  { cmd: "notes", href: "/getting-started/introduction/overview/" },
  { cmd: "appsec", href: "/appsec/" },
  { cmd: "malware", href: "/malware/" },
  { cmd: "tools", href: "/tools/" },
  { cmd: "about", href: "/about/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <FontPreload fonts={["syne-800", "mono-400"]} />
    <title>v0iid — Field Notes</title>
    <meta
      name="description"
      content="A personal ledger of reconstructed paths, annotated observations, and indexed findings — kept for reference, not spectacle."
    />
    {sections.map((s) => <link rel="prefetch" href={s.href} />)}
  </head>
  <body>
    <canvas id="void" aria-hidden="true"></canvas>
    <div class="depth" aria-hidden="true"></div>

    <header class="bar">
      <a class="brand" href="/">v0iid</a>
      <nav class="bar__nav" aria-label="Primary">
        {sections.map((s) => <a href={s.href}>{s.cmd}</a>)}
      </nav>
    </header>

    <main class="core">
      <p class="kick">// signals from the deep end</p>
      <h1 class="title">v0iid</h1>
      <p class="say">the emptiness between every packet</p>
    </main>

    <footer class="edge">
      <span class="rights">© 2026 v0iid · present day · present time</span>
    </footer>

    <script>
      const canvas = document.getElementById("void") as HTMLCanvasElement | null;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (canvas) {
        const ctx = canvas.getContext("2d")!;
        let w = 0,
          h = 0,
          dpr = Math.min(devicePixelRatio || 1, 2);
        const RINGS = 30;
        const GROW = 1.19; // perspective spacing between frames
        let phase = 0;
        // Vanishing point, nudged by the cursor for parallax.
        let vpx = 0,
          vpy = 0,
          tvx = 0,
          tvy = 0;

        const resize = () => {
          w = canvas.clientWidth;
          h = canvas.clientHeight;
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        addEventListener("resize", resize);
        addEventListener(
          "pointermove",
          (e) => {
            tvx = (e.clientX - w / 2) * 0.05;
            tvy = (e.clientY - h / 2) * 0.05;
          },
          { passive: true }
        );

        const frame = (cx: number, cy: number, half: number, rot: number, a: number) => {
          ctx.save();
          ctx.translate(cx, cy);
          ctx.rotate(rot);
          ctx.strokeStyle = `rgba(226, 232, 248, ${a})`;
          ctx.lineWidth = 1;
          ctx.strokeRect(-half, -half, half * 2, half * 2);
          ctx.restore();
        };

        const draw = () => {
          ctx.clearRect(0, 0, w, h);
          vpx += (tvx - vpx) * 0.06;
          vpy += (tvy - vpy) * 0.06;
          const cx = w / 2 + vpx;
          const cy = h / 2 + vpy;
          const base = 10;
          phase += 0.014;

          for (let i = 0; i < RINGS; i++) {
            const f = (i + (phase % 1)) ; // fractional depth
            const scale = Math.pow(GROW, f);
            const half = base * scale;
            if (half > Math.hypot(w, h)) continue;
            // fade in from the far point, fade out as the frame passes us
            const k = f / RINGS;
            const a = Math.sin(k * Math.PI) * 0.5;
            const rot = f * 0.14; // twist with depth → wormhole
            frame(cx, cy, half, rot, a);
          }
          if (!reduce) requestAnimationFrame(draw);
        };
        draw();
      }
    </script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :root {
        --bg: #000000;
        --ink: #eef1f8;
        --mute: #6b7082;
        --faint: #30333f;
        --accent: #e2e8f8;
        --accent-rgb: 226, 232, 248;
        --display: "Syne", system-ui, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
        --pad: clamp(1.2rem, 5vw, 4rem);
      }

      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--mono);
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      #void {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
      }
      /* Vanishing-point glow + outer darkness, so the tunnel recedes into nothing. */
      .depth {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background:
          radial-gradient(14% 14% at 50% 50%, rgba(var(--accent-rgb), 0.14), transparent 70%),
          radial-gradient(120% 120% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
      }

      /* ── Bar ── */
      .bar {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.3rem var(--pad);
      }
      .brand {
        font-family: var(--display);
        font-weight: 800;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
      }
      .bar__nav {
        display: flex;
        gap: 1.6rem;
        font-size: 0.95rem;
        letter-spacing: 0.1em;
      }
      .bar__nav a {
        color: var(--mute);
        transition: color 0.25s ease, text-shadow 0.25s ease;
      }
      .bar__nav a:hover {
        color: var(--ink);
        text-shadow: 0 0 14px rgba(var(--accent-rgb), 0.8);
      }

      /* ── Core ── */
      .core {
        position: fixed;
        inset: 0;
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
        padding: var(--pad);
      }
      .kick {
        margin: 0 0 2.2rem;
        font-size: 0.74rem;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--mute);
      }
      .title {
        margin: 0;
        font-family: var(--display);
        font-weight: 800;
        font-size: clamp(4rem, 15vw, 12rem);
        line-height: 0.9;
        letter-spacing: -0.06em;
        color: var(--ink);
        text-shadow: 0 0 90px rgba(0, 0, 0, 0.9), 0 0 30px rgba(0, 0, 0, 0.9);
      }
      .say {
        margin: 2.4rem 0 0;
        font-size: 0.82rem;
        letter-spacing: 0.1em;
        color: var(--mute);
      }

      /* ── Edge ── */
      .edge {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 1.3rem var(--pad);
        font-size: 0.68rem;
      }
      .enter {
        color: var(--ink);
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease;
      }
      .enter:hover {
        border-color: var(--ink);
      }
      .rights {
        letter-spacing: 0.08em;
        color: var(--faint);
      }

      @media (max-width: 40rem) {
        .bar__nav { gap: 0.75rem; font-size: 0.72rem; letter-spacing: 0.04em; }
        .rights { display: none; }
        .edge { justify-content: center; }
      }

      @media (prefers-reduced-motion: reduce) {
        .depth { background:
          radial-gradient(14% 14% at 50% 50%, rgba(var(--accent-rgb), 0.14), transparent 70%),
          radial-gradient(120% 120% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.7) 100%); }
      }
    </style>
  </body>
</html>
